# Variabili d'ambiente (copia in `.env`). Tutte opzionali.

# --- OpenCode Go (motore AI / LLM, opzionale) -------------------------------
# Se non impostata, la chiave viene letta da:
#   ~/.local/share/opencode/auth.json  (provider "opencode-go")
# OPENCODE_API_KEY=oc_sk_...
# OPENCODE_GO_MODEL=deepseek-v4.1-flash
# OPENCODE_GO_ENABLED=1
# OPENCODE_GO_REASONING=none
# OPENCODE_GO_MAX_TOKENS=600

# --- ARASAAC ---------------------------------------------------------------
# Lingue dei pittogrammi da scaricare/caricare (separate da virgola).
# ARASAAC_LANGUAGES=it,en
# ARASAAC_LANGUAGE=it

# --- spaCy -----------------------------------------------------------------
# SPACY_MODEL=it_core_news_md

# --- Rete / CORS -----------------------------------------------------------
# Origini extra consentite per l'API (separate da virgola).
# CORS_ORIGINS=http://192.168.1.10:5173
